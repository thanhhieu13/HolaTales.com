APP_NAME=HolaTales
APP_ENV=local
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=holatales
DB_USERNAME=holatales
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
PYTHON_CONTAINER_NAME=http://127.0.0.1
BROADCAST_DRIVER=log
PUSHER_APP_ID=local
PUSHER_APP_KEY=local
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MAIL_MAILER=log
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_CLIENT_PORT=6001
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Local AI translation uses local compute/storage. Requires the configured Ollama model.
TRANSLATION_BACKGROUND=true
TRANSLATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=qwen3.5:4b
TRANSLATION_TIMEOUT=180

# Dedicated worker: php artisan queue:work translations --queue=translations --timeout=240 --tries=2
